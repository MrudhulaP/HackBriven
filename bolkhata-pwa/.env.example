# Gnani (Vachana) key. Backend only: never put it in the frontend or in git.
GNANI_API_KEY=
# 32 random bytes, base64. Make one with:  python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
# false = start with an empty shop (no synthetic demo customers)
SEED_DEMO=true

# LLM brain (optional). Without these keys the app runs on rules only, exactly as before.
# Free keys: Groq -> console.groq.com -> API Keys;  Gemini -> aistudio.google.com -> Get API key
GROQ_API_KEY=
GEMINI_API_KEY=
# Leave empty for the defaults: openai/gpt-oss-120b (Groq) and gemini-3.5-flash-lite (Gemini)
GROQ_MODEL=
GEMINI_MODEL=
# false = never call an LLM
LLM_ENABLED=true
